enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum MessageReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  OTHER
}

enum MessageReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model User {
  id                  String                    @id
  email               String                    @unique
  name                String
  nickname            String                    @unique
  avatarUrl           String?                   @map("avatar_url")
  role                UserRole                  @default(USER)
  status              UserStatus                @default(ACTIVE)
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  blocksCreated       UserBlock[]               @relation("Blocker")
  blocksReceived      UserBlock[]               @relation("Blocked")
  reports             MessageReport[]
  characters          Character[]
  participants        ConversationParticipant[]
  sentMessages        ChatMessage[]
  campaignsAsDm       Campaign[]                @relation("CampaignDm")
  campaignMemberships CampaignMember[]
  campaignCharacters  CampaignCharacter[]
  attendances         GameAttendance[]
  campaignNotes       CampaignNote[]
  sharedCampaignNotes CampaignNoteShare[]
  sessionAttendees    SessionAttendee[]
  sessionFeedback     SessionFeedback[]
  sessionNotes        SessionNote[]
  adminActions        AdminAuditLog[]           @relation("AdminActions")
  auditTargets        AdminAuditLog[]           @relation("AuditTargets")

  @@map("users")
}

model AdminAuditLog {
  id           String         @id @default(cuid())
  adminId      String         @map("admin_id")
  action       String
  reason       String
  reportId     String?        @map("report_id")
  messageId    String?        @map("message_id")
  targetUserId String?        @map("target_user_id")
  metadata     Json?
  createdAt    DateTime       @default(now()) @map("created_at")
  admin        User           @relation("AdminActions", fields: [adminId], references: [id], onDelete: Restrict)
  targetUser   User?          @relation("AuditTargets", fields: [targetUserId], references: [id], onDelete: SetNull)
  report       MessageReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  message      ChatMessage?   @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([reportId])
  @@index([targetUserId])
  @@map("admin_audit_logs")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("user_blocks")
}

model MessageReport {
  id         String              @id @default(cuid())
  reporterId String              @map("reporter_id")
  messageId  String              @map("message_id")
  reason     MessageReportReason
  status     MessageReportStatus @default(PENDING)
  createdAt  DateTime            @default(now()) @map("created_at")
  reporter   User                @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  message    ChatMessage         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  auditLogs  AdminAuditLog[]

  @@map("message_reports")
}

model Conversation {
  id           String                    @id @default(cuid())
  isGroup      Boolean                   @default(false) @map("is_group")
  title        String?
  createdAt    DateTime                  @default(now()) @map("created_at")
  participants ConversationParticipant[]
  messages     ChatMessage[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  userId         String       @map("user_id")
  isAdmin        Boolean      @default(false) @map("is_admin")
  joinedAt       DateTime     @default(now()) @map("joined_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model ChatMessage {
  id             String              @id @default(cuid())
  conversationId String              @map("conversation_id")
  senderId       String              @map("sender_id")
  content        String              @db.Text
  isDeleted      Boolean             @default(false) @map("is_deleted")
  createdAt      DateTime            @default(now()) @map("created_at")
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments    MessageAttachment[]
  reports        MessageReport[]
  auditLogs      AdminAuditLog[]

  @@map("chat_messages")
}

model MessageAttachment {
  id        String      @id @default(cuid())
  messageId String      @map("message_id")
  fileUrl   String      @map("file_url")
  fileType  String      @map("file_type")
  createdAt DateTime    @default(now()) @map("created_at")
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}