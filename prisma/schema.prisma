generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  WEAPON
  ARMOR
  SHIELD
  TOOL
  GEAR
  CONSUMABLE
}

enum ResetCondition {
  SHORT_REST
  LONG_REST
  SPECIAL
}

enum MessageReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  OTHER
}

enum MessageReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum CampaignRole {
  DM
  CO_DM
  PLAYER
}

enum ItemRarity {
  MUNDANE
  COMMON
  UNCOMMON
  RARE
  VERY_RARE
  LEGENDARY
  ARTIFACT
}

enum ScheduleFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

enum ScheduledGameStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AttendanceStatus {
  ATTENDING
  NOT_ATTENDING
  TENTATIVE
  NO_REPLY
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum SkillProficiency {
  NONE
  PROFICIENT
  EXPERTISE
}

enum AbilityScore {
  STRENGTH
  DEXTERITY
  CONSTITUTION
  INTELLIGENCE
  WISDOM
  CHARISMA
}

enum CreatureSize {
  TINY
  SMALL
  MEDIUM
  LARGE
  HUGE
  GARGANTUAN
}

enum SpellcastingProgression {
  NONE
  FULL
  HALF
  THIRD
  PACT
}

enum ArmorCategory {
  NONE
  LIGHT
  MEDIUM
  HEAVY
  SHIELD
}

model SourceBook {
  id               String               @id @default(cuid())
  code             String               @unique
  title            String
  isOfficial       Boolean              @default(true) @map("is_official")
  enabledByDefault Boolean              @default(true) @map("enabled_by_default")
  species          Species[]
  subspecies       Subspecies[]
  backgrounds      Background[]
  classes          DndClass[]
  subclasses       DndSubclass[]
  spells           Spell[]
  feats            Feats[]
  classFeatures    ClassFeature[]
  skillDefinitions SkillDefinition[]
  equipment        EquipmentItem[]
  monsters         Monster[]
  campaigns        CampaignSourceBook[]
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@map("source_books")
}

model User {
  id                  String                    @id
  email               String                    @unique
  name                String
  nickname            String                    @unique
  avatarUrl           String?                   @map("avatar_url")
  role                UserRole                  @default(USER)
  status              UserStatus                @default(ACTIVE)
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  blocksCreated       UserBlock[]               @relation("Blocker")
  blocksReceived      UserBlock[]               @relation("Blocked")
  reports             MessageReport[]
  characters          Character[]
  participants        ConversationParticipant[]
  sentMessages        ChatMessage[]
  campaignsAsDm       Campaign[]                @relation("CampaignDm")
  campaignMemberships CampaignMember[]
  campaignCharacters  CampaignCharacter[]
  attendances         GameAttendance[]
  campaignNotes       CampaignNote[]
  sharedCampaignNotes CampaignNoteShare[]
  sessionAttendees    SessionAttendee[]
  sessionFeedback     SessionFeedback[]
  sessionNotes        SessionNote[]
  adminActions        AdminAuditLog[]           @relation("AdminActions")
  auditTargets        AdminAuditLog[]           @relation("AuditTargets")

  @@map("users")
}

model AdminAuditLog {
  id           String         @id @default(cuid())
  adminId      String         @map("admin_id")
  action       String
  reason       String
  reportId     String?        @map("report_id")
  messageId    String?        @map("message_id")
  targetUserId String?        @map("target_user_id")
  metadata     Json?
  createdAt    DateTime       @default(now()) @map("created_at")
  admin        User           @relation("AdminActions", fields: [adminId], references: [id], onDelete: Restrict)
  targetUser   User?          @relation("AuditTargets", fields: [targetUserId], references: [id], onDelete: SetNull)
  report       MessageReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  message      ChatMessage?   @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([reportId])
  @@index([targetUserId])
  @@map("admin_audit_logs")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("user_blocks")
}

model MessageReport {
  id         String              @id @default(cuid())
  reporterId String              @map("reporter_id")
  messageId  String              @map("message_id")
  reason     MessageReportReason
  status     MessageReportStatus @default(PENDING)
  createdAt  DateTime            @default(now()) @map("created_at")
  reporter   User                @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  message    ChatMessage         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  auditLogs  AdminAuditLog[]

  @@map("message_reports")
}

model Character {
  id                  String                     @id @default(cuid())
  userId              String                     @map("user_id")
  name                String
  avatarUrl           String?                    @map("avatar_url")
  race                String?
  class               String?
  subclass            String?
  level               Int                        @default(1)
  stats               Json
  foundryActorId      String?                    @map("foundry_actor_id")
  foundryVersion      String?                    @map("foundry_version")
  rawImportData       Json?                      @map("raw_import_data")
  speciesId           String?                    @map("species_id")
  subspeciesId        String?                    @map("subspecies_id")
  backgroundId        String?                    @map("background_id")
  dndClassId          String?                    @map("dnd_class_id")
  subclassId          String?                    @map("subclass_id")
  strength            Int                        @default(10)
  dexterity           Int                        @default(10)
  constitution        Int                        @default(10)
  intelligence        Int                        @default(10)
  wisdom              Int                        @default(10)
  charisma            Int                        @default(10)
  strengthMod         Int                        @default(0) @map("strength_mod")
  dexterityMod        Int                        @default(0) @map("dexterity_mod")
  constitutionMod     Int                        @default(0) @map("constitution_mod")
  intelligenceMod     Int                        @default(0) @map("intelligence_mod")
  wisdomMod           Int                        @default(0) @map("wisdom_mod")
  charismaMod         Int                        @default(0) @map("charisma_mod")
  savingThrows        Json                       @default("{}") @map("saving_throws")
  skillProficiencies  Json                       @default("{}") @map("skill_proficiencies")
  spellSlots          Json?                      @default("{}") @map("spell_slots")
  maxHitPoints        Int                        @default(1) @map("max_hit_points")
  currentHitPoints    Int                        @default(1) @map("current_hit_points")
  temporaryHitPoints  Int                        @default(0) @map("temporary_hit_points")
  hitDie              Int                        @default(8) @map("hit_die")
  hitDiceTotal        Int                        @default(1) @map("hit_dice_total")
  hitDiceCurrent      Int                        @default(1) @map("hit_dice_current")
  armorClass          Int                        @default(10) @map("armor_class")
  initiative          Int                        @default(0)
  speed               Int                        @default(30)
  spellSaveDc         Int?                       @map("spell_save_dc")
  spellAttackBonus    Int?                       @map("spell_attack_bonus")
  inspiration         Boolean                    @default(false)
  themeKey            String                     @default("warrior") @map("theme_key")
  armorCategory       ArmorCategory              @default(NONE) @map("armor_category")
  armorBaseClass      Int?                       @map("armor_base_class")
  armorDexCap         Int?                       @map("armor_dex_cap")
  shieldBonus         Int                        @default(0) @map("shield_bonus")
  selectedFeats       Json                       @default("[]") @map("selected_feats")
  copperPieces        Int                        @default(0) @map("copper_pieces")
  silverPieces        Int                        @default(0) @map("silver_pieces")
  electrumPieces      Int                        @default(0) @map("electrum_pieces")
  goldPieces          Int                        @default(0) @map("gold_pieces")
  platinumPieces      Int                        @default(0) @map("platinum_pieces")
  personalityTraits   String?                    @db.Text @map("personality_traits")
  ideals              String?                    @db.Text
  bonds               String?                    @db.Text
  flaws               String?                    @db.Text
  appearance          String?                    @db.Text
  backstory           String?                    @db.Text
  alliesOrganizations String?                    @db.Text @map("allies_organizations")
  notebookTheme       String?                    @default("parchment") @map("notebook_theme")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  species             Species?                   @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  dndSubspecies       Subspecies?                @relation(fields: [subspeciesId], references: [id], onDelete: SetNull)
  background          Background?                @relation(fields: [backgroundId], references: [id], onDelete: SetNull)
  dndClass            DndClass?                  @relation(fields: [dndClassId], references: [id], onDelete: SetNull)
  dndSubclass         DndSubclass?               @relation(fields: [subclassId], references: [id], onDelete: SetNull)
  notebooks           CharacterNotebook[]
  campaignLinks       CampaignCharacter[]
  sessionLinks        SessionAttendee[]
  sessionNotes        SessionNote[]
  spells              CharacterSpell[]
  inventory           CharacterInventoryItem[]
  weaponMasteries     CharacterWeaponMastery[]
  resources           CharacterResourceTracker[]
  languages           CharacterLanguage[]

  @@map("characters")
}

model Species {
  id             String       @id @default(cuid())
  slug           String       @unique
  name           String
  speed          Int          @default(30)
  size           CreatureSize @default(MEDIUM)
  darkvision     Int?
  traits         Json         @default("[]")
  innateSpellIds Json         @default("[]") @map("innate_spell_ids")
  subspecies     Subspecies[]
  characters     Character[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  sourceBookId   String?      @map("source_book_id")
  sourceBook     SourceBook?  @relation(fields: [sourceBookId], references: [id], onDelete: SetNull)

  @@map("species")
}

model Subspecies {
  id           String      @id @default(cuid())
  speciesId    String      @map("species_id")
  slug         String      @unique
  name         String
  speed        Int?
  traits       Json        @default("[]")
  species      Species     @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  characters   Character[]
  sourceBookId String?     @map("source_book_id")
  sourceBook   SourceBook? @relation(fields: [sourceBookId], references: [id], onDelete: SetNull)

  @@map("subspecies")
}

model Background {
  id                 String      @id @default(cuid())
  slug               String      @unique
  name               String
  source             String      @default("XPHB")
  page               String?
  description        String?     @db.Text
  abilityChoices     Json        @default("[]") @map("ability_choices")
  originFeatId       String?     @map("origin_feat_id")
  skillProficiencies Json        @default("[]") @map("skill_proficiencies")
  toolProficiencies  Json        @default("[]") @map("tool_proficiencies")
  startingEquipment  Json        @default("[]") @map("starting_equipment")
  originFeat         Feats?      @relation(fields: [originFeatId], references: [id], onDelete: SetNull)
  characters         Character[]
  sourceBookId       String?     @map("source_book_id")
  sourceBook         SourceBook? @relation(fields: [sourceBookId], references: [id], onDelete: SetNull)

  @@index([source])
  @@map("backgrounds")
}

model DndClass {
  id                      String                    @id @default(cuid())
  slug                    String                    @unique
  name                    String
  hitDie                  Int                       @map("hit_die")
  savingThrows            Json                      @map("saving_throws")
  skillChoices            Int                       @default(2) @map("skill_choices")
  skillOptions            Json                      @map("skill_options")
  spellcastingAbility     AbilityScore?             @map("spellcasting_ability")
  spellcastingProgression SpellcastingProgression   @default(NONE) @map("spellcasting_progression")
  subclasses              DndSubclass[]
  levelFeatures           ClassLevelFeature[]
  characters              Character[]
  classFeatures           ClassFeature[]
  resourceDefinitions     ClassResourceDefinition[]
  sourceBookId            String?                   @map("source_book_id")
  sourceBook              SourceBook?               @relation(fields: [sourceBookId], references: [id], onDelete: SetNull)

  @@map("dnd_classes")
}

model DndSubclass {
  id            String              @id @default(cuid())
  dndClassId    String              @map("dnd_class_id")
  slug          String              @unique
  name          String
  description   String
  dndClass      DndClass            @relation(fields: [dndClassId], references: [id], onDelete: Cascade)
  features      ClassLevelFeature[]
  classFeatures ClassFeature[]
  characters    Character[]
  sourceBookId  String?             @map("source_book_id")
  sourceBook    SourceBook?         @relation(fields: [sourceBookId], references: [id], onDelete: SetNull)

  @@map("dnd_subclasses")
}

model ClassLevelFeature {
  id          String       @id @default(cuid())
  dndClassId  String       @map("dnd_class_id")
  subclassId  String?      @map("subclass_id")
  level       Int
  name        String
  description String
  dndClass    DndClass     @relation(fields: [dndClassId], references: [id], onDelete: Cascade)
  subclass    DndSubclass? @relation(fields: [subclassId], references: [id], onDelete: Cascade)

  @@unique([dndClassId, subclassId, level, name])
  @@map("class_level_features")
}

model ClassFeature {
  id            String       @id @default(cuid())
  sourceBookId  String       @map("source_book_id")
  sourceBook    SourceBook   @relation(fields: [sourceBookId], references: [id], onDelete: Cascade)
  dndClassId    String       @map("dnd_class_id")
  dndClass      DndClass     @relation(fields: [dndClassId], references: [id], onDelete: Cascade)
  dndSubclassId String?      @map("dnd_subclass_id")
  dndSubclass   DndSubclass? @relation(fields: [dndSubclassId], references: [id], onDelete: Cascade)
  level         Int
  name          String
  description   String       @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([dndClassId, level])
  @@map("class_features")
}

model Spell {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  source          String           @default("PHB'14")
  page            String?
  level           Int
  school          String
  castingTime     String           @map("casting_time")
  range           String
  components      Json
  materials       String?
  duration        String
  concentration   Boolean          @default(false)
  ritual          Boolean          @default(false)
  description     String           @db.Text
  higherLevels    String?          @map("higher_levels") @db.Text
  classes         Json             @default("[]")
  optionalClasses Json             @default("[]") @map("optional_classes")
  subclasses      Json             @default("[]")
  characters      CharacterSpell[]
  sourceBookId    String?          @map("source_book_id")
  sourceBook      SourceBook?      @relation(fields: [sourceBookId], references: [id], onDelete: SetNull)

  @@index([level])
  @@index([school])
  @@index([source])
  @@map("spells")
}

model Feats {
  id               String       @id @default(cuid())
  slug             String       @unique
  name             String
  source           String       @default("PHB_2024")
  category         String
  levelRequirement Int          @default(1) @map("level_requirement")
  prerequisite     String?
  description      String       @db.Text
  repeatable       Boolean      @default(false)
  backgrounds      Background[]
  sourceBookId     String?      @map("source_book_id")
  sourceBook       SourceBook?  @relation(fields: [sourceBookId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([levelRequirement])
  @@map("feats")
}

model SkillDefinition {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  ability      String
  description  String      @db.Text
  examples     String      @db.Text
  sourceBookId String?     @map("source_book_id")
  sourceBook   SourceBook? @relation(fields: [sourceBookId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("skill_definitions")
}

model EquipmentItem {
  id                  String                   @id @default(cuid())
  slug                String                   @unique
  name                String
  category            String
  description         String
  weight              Float?
  costCp              Int?                     @map("cost_cp")
  armorCategory       ArmorCategory?           @map("armor_category")
  armorClass          Int?                     @map("armor_class")
  dexterityCap        Int?                     @map("dexterity_cap")
  shieldBonus         Int?                     @map("shield_bonus")
  weaponMastery       String?                  @map("weapon_mastery")
  type                ItemType?
  costGp              Float?                   @map("cost_gp")
  weightLb            Float?                   @map("weight_lb")
  damageFormula       String?                  @map("damage_formula")
  damageType          String?                  @map("damage_type")
  properties          String[]                 @default([])
  rangeNormal         Int?                     @map("range_normal")
  rangeLong           Int?                     @map("range_long")
  masteryPropertyId   String?                  @map("mastery_property_id")
  masteryProperty     WeaponMasteryProperty?   @relation(fields: [masteryPropertyId], references: [id], onDelete: SetNull)
  dexterityBonusMax   Int?                     @map("dexterity_bonus_max")
  strengthRequirement Int?                     @map("strength_requirement")
  stealthDisadvantage Boolean                  @default(false) @map("stealth_disadvantage")
  characters          CharacterInventoryItem[]
  sourceBookId        String?                  @map("source_book_id")
  sourceBook          SourceBook?              @relation(fields: [sourceBookId], references: [id], onDelete: SetNull)

  @@index([category])
  @@map("equipment_items")
}

model WeaponMasteryProperty {
  id          String                   @id @default(cuid())
  code        String                   @unique
  name        String
  description String                   @db.Text
  items       EquipmentItem[]
  characters  CharacterWeaponMastery[]
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  @@map("weapon_mastery_properties")
}

model CharacterWeaponMastery {
  id          String                @id @default(cuid())
  characterId String                @map("character_id")
  masteryId   String                @map("mastery_id")
  character   Character             @relation(fields: [characterId], references: [id], onDelete: Cascade)
  mastery     WeaponMasteryProperty @relation(fields: [masteryId], references: [id], onDelete: Cascade)

  @@unique([characterId, masteryId])
  @@map("character_weapon_masteries")
}

model ClassResourceDefinition {
  id             String         @id @default(cuid())
  dndClassId     String         @map("dnd_class_id")
  name           String
  resetCondition ResetCondition @map("reset_condition")
  formulaByLevel Json           @map("formula_by_level")
  diceFormula    String?        @map("dice_formula")
  dndClass       DndClass       @relation(fields: [dndClassId], references: [id], onDelete: Cascade)

  @@index([dndClassId])
  @@map("class_resource_definitions")
}

model CharacterResourceTracker {
  id             String         @id @default(cuid())
  characterId    String         @map("character_id")
  name           String
  currentValue   Int            @map("current_value")
  maxValue       Int            @map("max_value")
  diceFormula    String?        @map("dice_formula")
  resetCondition ResetCondition @map("reset_condition")
  character      Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@map("character_resource_trackers")
}

model Language {
  id         String              @id @default(cuid())
  name       String              @unique
  script     String
  isExotic   Boolean             @default(false) @map("is_exotic")
  characters CharacterLanguage[]

  @@map("languages")
}

model CharacterLanguage {
  id          String    @id @default(cuid())
  characterId String    @map("character_id")
  languageId  String    @map("language_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  language    Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([characterId, languageId])
  @@map("character_languages")
}

model Monster {
  id                    String       @id @default(cuid())
  name                  String
  slug                  String       @unique
  size                  CreatureSize @default(MEDIUM)
  creatureType          String       @map("creature_type")
  subtype               String?
  alignment             String?
  challengeRating       String       @map("challenge_rating")
  cr                    Float?
  proficiencyBonus      Int          @default(2) @map("proficiency_bonus")
  armorClass            Int          @map("armor_class")
  armorType             String?      @map("armor_type")
  hitPoints             Int          @map("hit_points")
  hitDice               String?      @map("hit_dice")
  speed                 Json         @default("{}")
  strength              Int          @default(10)
  dexterity             Int          @default(10)
  constitution          Int          @default(10)
  intelligence          Int          @default(10)
  wisdom                Int          @default(10)
  charisma              Int          @default(10)
  savingThrows          Json         @default("{}") @map("saving_throws")
  skills                Json         @default("{}")
  damageVulnerabilities Json         @default("[]") @map("damage_vulnerabilities")
  damageResistances     Json         @default("[]") @map("damage_resistances")
  damageImmunities      Json         @default("[]") @map("damage_immunities")
  conditionImmunities   Json         @default("[]") @map("condition_immunities")
  senses                Json         @default("{}")
  sensesText            String?      @map("senses_text")
  passivePerception     Int?         @map("passive_perception")
  languages             Json         @default("[]")
  languagesText         String?      @map("languages_text")
  traits                Json         @default("[]")
  actions               Json         @default("[]")
  bonusActions          Json         @default("[]") @map("bonus_actions")
  reactions             Json         @default("[]")
  legendaryResistances  Int          @default(0) @map("legendary_resistances")
  legendaryActions      Json         @default("[]") @map("legendary_actions")
  legendaryActionsCount Int          @default(0) @map("legendary_actions_count")
  lairActions           Json         @default("[]") @map("lair_actions")
  hasLair               Boolean      @default(false) @map("has_lair")
  regionalEffects       Json         @default("[]") @map("regional_effects")
  isLegendary           Boolean      @default(false) @map("is_legendary")
  sourceBookId          String?      @map("source_book_id")
  sourceBook            SourceBook?  @relation(fields: [sourceBookId], references: [id], onDelete: SetNull)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  @@index([challengeRating])
  @@index([creatureType])
  @@map("monsters")
}

model CampaignSourceBook {
  campaignId   String     @map("campaign_id")
  sourceBookId String     @map("source_book_id")
  enabled      Boolean    @default(true)
  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sourceBook   SourceBook @relation(fields: [sourceBookId], references: [id], onDelete: Cascade)

  @@id([campaignId, sourceBookId])
  @@map("campaign_source_books")
}

model CharacterSpell {
  characterId String    @map("character_id")
  spellId     String    @map("spell_id")
  prepared    Boolean   @default(false)
  learned     Boolean   @default(true)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  spell       Spell     @relation(fields: [spellId], references: [id], onDelete: Cascade)

  @@id([characterId, spellId])
  @@map("character_spells")
}

model CharacterInventoryItem {
  id          String         @id @default(cuid())
  characterId String         @map("character_id")
  equipmentId String?        @map("equipment_id")
  customName  String?        @map("custom_name")
  quantity    Int            @default(1)
  equipped    Boolean        @default(false)
  notes       String?
  character   Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  equipment   EquipmentItem? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  @@index([characterId])
  @@map("character_inventory_items")
}

model CharacterNotebook {
  id          String           @id @default(cuid())
  characterId String           @map("character_id")
  title       String
  subject     String
  content     String
  isShared    Boolean          @default(false) @map("is_shared")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  character   Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  attachments NoteAttachment[]

  @@map("character_notebooks")
}

model NoteAttachment {
  id         String            @id @default(cuid())
  notebookId String            @map("notebook_id")
  fileUrl    String            @map("file_url")
  caption    String?
  createdAt  DateTime          @default(now()) @map("created_at")
  notebook   CharacterNotebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  @@map("note_attachments")
}

model Conversation {
  id           String                    @id @default(cuid())
  isGroup      Boolean                   @default(false) @map("is_group")
  title        String?
  createdAt    DateTime                  @default(now()) @map("created_at")
  participants ConversationParticipant[]
  messages     ChatMessage[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  userId         String       @map("user_id")
  isAdmin        Boolean      @default(false) @map("is_admin")
  joinedAt       DateTime     @default(now()) @map("joined_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model ChatMessage {
  id             String              @id @default(cuid())
  conversationId String              @map("conversation_id")
  senderId       String              @map("sender_id")
  content        String
  isDeleted      Boolean             @default(false) @map("is_deleted")
  createdAt      DateTime            @default(now()) @map("created_at")
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments    MessageAttachment[]
  reports        MessageReport[]
  auditLogs      AdminAuditLog[]

  @@map("chat_messages")
}

model MessageAttachment {
  id        String      @id @default(cuid())
  messageId String      @map("message_id")
  fileUrl   String      @map("file_url")
  fileType  String      @map("file_type")
  createdAt DateTime    @default(now()) @map("created_at")
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

model Campaign {
  id             String               @id @default(cuid())
  dmId           String               @map("dm_id")
  title          String
  description    String
  inviteCode     String               @unique @map("invite_code")
  createdAt      DateTime             @default(now()) @map("created_at")
  dm             User                 @relation("CampaignDm", fields: [dmId], references: [id], onDelete: Cascade)
  members        CampaignMember[]
  characters     CampaignCharacter[]
  locations      Location[]
  npcs           NPC[]
  shops          Shop[]
  scheduleRules  ScheduleRule[]
  scheduledGames ScheduledGame[]
  notes          CampaignNote[]
  sessionLogs    SessionLog[]
  sourceBooks    CampaignSourceBook[]

  @@map("campaigns")
}

model CampaignMember {
  id             String       @id @default(cuid())
  campaignId     String       @map("campaign_id")
  userId         String       @map("user_id")
  role           CampaignRole
  dmPrivateNotes String?      @map("dm_private_notes")
  joinedAt       DateTime     @default(now()) @map("joined_at")
  campaign       Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@map("campaign_members")
}

model CampaignCharacter {
  id          String    @id @default(cuid())
  campaignId  String    @map("campaign_id")
  characterId String    @map("character_id")
  playerId    String    @map("player_id")
  isActive    Boolean   @default(true) @map("is_active")
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  player      User      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, characterId])
  @@map("campaign_characters")
}

model Location {
  id                String                   @id @default(cuid())
  campaignId        String                   @map("campaign_id")
  parentId          String?                  @map("parent_id")
  name              String
  description       String
  isSecretDm        Boolean                  @default(false) @map("is_secret_dm")
  campaign          Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  parent            Location?                @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          Location[]               @relation("LocationHierarchy")
  shops             Shop[]
  visitedInSessions SessionVisitedLocation[]

  @@map("locations")
}

model NPC {
  id            String          @id @default(cuid())
  campaignId    String          @map("campaign_id")
  name          String
  race          String?
  occupation    String?
  appearance    String
  secretsDm     String?         @map("secrets_dm")
  isSecretDm    Boolean         @default(false) @map("is_secret_dm")
  campaign      Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  shopsKept     Shop[]          @relation("ShopKeeper")
  metInSessions SessionMetNPC[]

  @@map("npcs")
}

model Shop {
  id          String     @id @default(cuid())
  campaignId  String     @map("campaign_id")
  locationId  String?    @map("location_id")
  keeperNpcId String?    @map("keeper_npc_id")
  name        String
  shopType    String     @map("shop_type")
  campaign    Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  location    Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  keeperNpc   NPC?       @relation("ShopKeeper", fields: [keeperNpcId], references: [id], onDelete: SetNull)
  items       ShopItem[]

  @@map("shops")
}

model ShopItem {
  id            String     @id @default(cuid())
  shopId        String     @map("shop_id")
  name          String
  description   String
  rarity        ItemRarity
  isMagic       Boolean    @default(false) @map("is_magic")
  priceCp       Int        @map("price_cp")
  stockQuantity Int        @default(-1) @map("stock_quantity")
  shop          Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("shop_items")
}

model ScheduleRule {
  id              String            @id @default(cuid())
  campaignId      String            @map("campaign_id")
  frequency       ScheduleFrequency
  dayOfWeek       Int               @map("day_of_week")
  startTime       String            @map("start_time")
  durationMinutes Int               @map("duration_minutes")
  campaign        Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scheduledGames  ScheduledGame[]

  @@map("schedule_rules")
}

model ScheduledGame {
  id             String              @id @default(cuid())
  campaignId     String              @map("campaign_id")
  scheduleRuleId String?             @map("schedule_rule_id")
  dateTime       DateTime            @map("date_time")
  title          String
  status         ScheduledGameStatus
  campaign       Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scheduleRule   ScheduleRule?       @relation(fields: [scheduleRuleId], references: [id], onDelete: SetNull)
  attendances    GameAttendance[]
  sessionLog     SessionLog?

  @@map("scheduled_games")
}

model GameAttendance {
  id       String           @id @default(cuid())
  gameId   String           @map("game_id")
  userId   String           @map("user_id")
  status   AttendanceStatus
  comment  String?
  game     ScheduledGame    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@map("game_attendance")
}

model CampaignNote {
  id         String              @id @default(cuid())
  campaignId String              @map("campaign_id")
  authorId   String              @map("author_id")
  isShared   Boolean             @map("is_shared")
  imageUrl   String?             @map("image_url")
  title      String
  content    String
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")
  campaign   Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  author     User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  shares     CampaignNoteShare[]

  @@map("campaign_notes")
}

model CampaignNoteShare {
  id     String       @id @default(cuid())
  noteId String       @map("note_id")
  userId String       @map("user_id")
  note   CampaignNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@map("campaign_note_shares")
}

model SessionLog {
  id               String                   @id @default(cuid())
  campaignId       String                   @map("campaign_id")
  scheduledGameId  String?                  @unique @map("scheduled_game_id")
  sessionNumber    Int                      @map("session_number")
  title            String
  playedAt         DateTime                 @map("played_at")
  summary          String
  dmNotes          String?                  @map("dm_notes")
  createdAt        DateTime                 @default(now()) @map("created_at")
  campaign         Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scheduledGame    ScheduledGame?           @relation(fields: [scheduledGameId], references: [id], onDelete: SetNull)
  attendees        SessionAttendee[]
  sessionNotes     SessionNote[]
  visitedLocations SessionVisitedLocation[]
  metNpcs          SessionMetNPC[]
  feedback         SessionFeedback[]

  @@map("session_logs")
}

model SessionAttendee {
  id          String      @id @default(cuid())
  sessionId   String      @map("session_id")
  userId      String      @map("user_id")
  characterId String?     @map("character_id")
  session     SessionLog  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character?  @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId])
  @@map("session_attendees")
}

model SessionVisitedLocation {
  id         String     @id @default(cuid())
  sessionId  String     @map("session_id")
  locationId String     @map("location_id")
  session    SessionLog @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  location   Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([sessionId, locationId])
  @@map("session_visited_locations")
}

model SessionMetNPC {
  id        String     @id @default(cuid())
  sessionId String     @map("session_id")
  npcId     String     @map("npc_id")
  session   SessionLog @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  npc       NPC        @relation(fields: [npcId], references: [id], onDelete: Cascade)

  @@unique([sessionId, npcId])
  @@map("session_met_npcs")
}

model SessionFeedback {
  id        String     @id @default(cuid())
  sessionId String     @map("session_id")
  userId    String     @map("user_id")
  rating    Int?
  comment   String
  isPublic  Boolean    @default(true) @map("is_public")
  createdAt DateTime   @default(now()) @map("created_at")
  session   SessionLog @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session_feedback")
}

model SessionNote {
  id          String     @id @default(cuid())
  sessionId   String     @map("session_id")
  userId      String     @map("user_id")
  characterId String?    @map("character_id")
  title       String
  content     String     @db.Text
  isShared    Boolean    @default(false) @map("is_shared")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  session     SessionLog @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([sessionId, userId])
  @@map("session_notes")
}